diff --git a/lib/fixers/version.js b/lib/fixers/version.js
new file mode 100644
index 0000000..3c270c6
--- /dev/null
+++ b/lib/fixers/version.js
@@ -0,0 +1,19 @@
+var isValidSemver = require('semver/functions/valid')
+var cleanSemver = require('semver/functions/clean')
+
+module.exports = function (fixer) {
+  return {
+    fixVersionField: function (data, strict) {
+      var loose = !strict
+      if (!data.version) {
+        data.version = ''
+        return true
+      }
+      if (!isValidSemver(data.version, loose)) {
+        throw new Error('Invalid version: "' + data.version + '"')
+      }
+      data.version = cleanSemver(data.version, loose)
+      return true
+    },
+  }
+}
